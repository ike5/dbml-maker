# These are the settings for docker-compose.selfhost.yml. Copy this file to .env. Then change the values.
#
# Keep the .env file private. It holds secrets. Do not commit it. Do not share it.
#
# To make a secret value, run this command:
#   openssl rand -hex 32
# Use hex characters only. A "$" in a value breaks Docker Compose.
# A special character in POSTGRES_PASSWORD breaks the database URL.

# --- Necessary values ---
# If one of these values is empty, Docker Compose stops and shows a message.

# The secret key of Django. If you change it, all users must log in again.
DJANGO_SECRET_KEY=

# The password of the database user. The database reads it at its first start only.
# If you change it later, change the password in the database too.
POSTGRES_PASSWORD=

# The public origin that users type in the browser, for example https://dbml.example.com. Do not add a path.
# If it starts with https://, Django sets secure cookies and redirects HTTP to HTTPS.
PUBLIC_BASE_URL=

# --- Email (SMTP) ---
# A new user must verify the email address before the first login.
# If the SMTP server does not work, nobody can log in. Set a server that the containers can reach.
# The host "localhost" is the container itself, not your server.
# For an SMTP server on the same host, use the IP address of the host.
# If EMAIL_HOST is empty, Docker Compose stops and shows a message.

# The host name of the SMTP server, for example smtp.example.com.
EMAIL_HOST=
# The port of the SMTP server. Port 587 uses STARTTLS.
EMAIL_PORT=587
# The user name for the SMTP server. If the server has no login, leave it empty.
EMAIL_HOST_USER=
# The password for the SMTP server. If the server has no login, leave it empty.
EMAIL_HOST_PASSWORD=
# Set true to use STARTTLS. The application cannot use implicit TLS (port 465).
EMAIL_USE_TLS=true

# --- Optional values ---
# Each line shows the default value. To change a value, remove the "#" at the start of the line. Then change the value.

# Set false to close the sign-up. Then only users that have an account can log in.
# SIGNUP_ENABLED=true

# The address that the web port listens on. If the reverse proxy runs on the same host, keep the default.
# WEB_BIND=127.0.0.1

# The host port of the web process.
# WEB_PORT=8000

# The number of gunicorn workers.
# WEB_CONCURRENCY=2

# The log level: DEBUG, INFO, WARNING, or ERROR.
# LOG_LEVEL=INFO

# The release number in the name of the image, for example 1.0.0.
# With the flag --build, Compose builds the image from the source and gives it this name.
# Without the flag, Compose pulls the image with this name.
# DBML_MAKER_VERSION=latest

# The sender address of the emails. The default is "noreply@" and the host of PUBLIC_BASE_URL.
# DEFAULT_FROM_EMAIL=noreply@dbml.example.com
